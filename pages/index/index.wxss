.container {
  min-height: 100vh;
  padding-bottom: calc(var(--app-tab-height, 112rpx) + 36rpx + env(safe-area-inset-bottom));
  background: #F4F7F7;
}

.header {
  position: relative;
  min-height: 140rpx;
  padding: 28rpx 30rpx 42rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #0F626C, #16828A);
}

.header::after {
  position: absolute;
  right: -8%;
  bottom: -54rpx;
  left: -8%;
  height: 76rpx;
  content: '';
  background: #42B8A5;
  border-radius: 50% 50% 0 0;
  opacity: 0.9;
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-info {
  display: flex;
  align-items: center;
  min-width: 0;
}

.avatar {
  width: 78rpx;
  height: 78rpx;
  margin-right: 18rpx;
  background: #FFFFFF;
  border: 4rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 50%;
}

.username {
  max-width: 250rpx;
  overflow: hidden;
  font-size: calc(34rpx * var(--app-font-scale, 1));
  font-weight: 700;
  color: #FFFFFF;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.family-switch {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 20rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 32rpx;
}

.family-name {
  max-width: 170rpx;
  overflow: hidden;
  font-size: calc(27rpx * var(--app-font-scale, 1));
  font-weight: 600;
  color: #FFFFFF;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.family-arrow {
  margin-left: 10rpx;
  font-size: calc(18rpx * var(--app-font-scale, 1));
  color: rgba(255, 255, 255, 0.85);
}

.banner {
  height: 270rpx;
  margin: 22rpx 24rpx 0;
  overflow: hidden;
  background: #DDEDEC;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(18, 55, 59, 0.08);
}

.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-text {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 140rpx;
  padding: 42rpx 28rpx 24rpx;
  color: #FFFFFF;
  background: linear-gradient(0deg, rgba(14, 47, 51, 0.8), rgba(14, 47, 51, 0));
}

.banner-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  overflow-wrap: anywhere;
  font-size: calc(38rpx * var(--app-font-scale, 1));
  font-weight: 700;
  line-height: 1.25;
}

.banner-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  overflow-wrap: anywhere;
  margin-top: 5rpx;
  font-size: calc(27rpx * var(--app-font-scale, 1));
  color: rgba(255, 255, 255, 0.9);
}

.section {
  padding: 34rpx 24rpx 0;
}

.section-header {
  min-height: 58rpx;
  margin-bottom: 18rpx;
}

.section-header .text-primary {
  font-size: calc(27rpx * var(--app-font-scale, 1));
  font-weight: 600;
}

.families-tasks-list {
  overflow: hidden;
  background: #FFFFFF;
  border: 1rpx solid #E3EAEA;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(18, 55, 59, 0.05);
}

.family-tasks-card {
  padding: 24rpx;
  border-bottom: 1rpx solid #E8EEEE;
}

.family-tasks-card:last-child {
  border-bottom: 0;
}

.family-tasks-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.family-tasks-name {
  font-size: calc(31rpx * var(--app-font-scale, 1));
  font-weight: 700;
  color: #223336;
}

.family-tasks-count {
  font-size: calc(25rpx * var(--app-font-scale, 1));
  color: #647579;
}

.family-goal-item {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #EEF2F2;
}

.family-goal-item:last-child {
  padding-bottom: 2rpx;
  border-bottom: 0;
}

.goal-info {
  flex: 1;
  min-width: 0;
}

.goal-name {
  display: block;
  overflow: hidden;
  font-size: calc(30rpx * var(--app-font-scale, 1));
  font-weight: 650;
  color: #29383B;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goal-desc {
  display: block;
  margin-top: 4rpx;
  font-size: calc(25rpx * var(--app-font-scale, 1));
  color: #718084;
}

.goal-progress {
  min-width: 108rpx;
  margin-left: 18rpx;
  text-align: right;
}

.progress-text {
  display: block;
  font-size: calc(31rpx * var(--app-font-scale, 1));
  font-weight: 700;
  color: #E08A1E;
}

.progress-label {
  display: block;
  font-size: calc(23rpx * var(--app-font-scale, 1));
  color: #7A898D;
}

.family-empty-tip,
.empty-tip {
  padding: 48rpx 24rpx;
  font-size: calc(28rpx * var(--app-font-scale, 1));
  color: #718084;
  text-align: center;
  background: #FFFFFF;
  border: 1rpx solid #E3EAEA;
  border-radius: 22rpx;
}

.join-family-btn-small {
  min-width: 180rpx;
  min-height: 72rpx;
  margin-top: 20rpx;
  font-size: calc(28rpx * var(--app-font-scale, 1));
  font-weight: 650;
  color: #176B73;
  background: #EAF6F4;
  border-radius: 16rpx;
}

.family-entry-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 20rpx;
}

.family-entry-actions .join-family-btn-small {
  flex: 1 1 220rpx;
  min-height: 44px;
  margin: 0;
  padding: 16rpx 20rpx;
  line-height: 1.5;
}

.family-entry-actions .create-family-btn {
  color: #FFFFFF;
  background: #176B73;
}

.category-tabs {
  display: flex;
  padding: 6rpx;
  margin-bottom: 18rpx;
  background: #E9EEEE;
  border-radius: 18rpx;
}

.category-tab {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 66rpx;
  font-size: calc(28rpx * var(--app-font-scale, 1));
  font-weight: 600;
  color: #5E6D71;
  border-radius: 14rpx;
}

.category-tab.active {
  color: #FFFFFF;
  background: #176B73;
  box-shadow: 0 4rpx 12rpx rgba(23, 107, 115, 0.18);
}

.exercise-list {
  overflow: hidden;
  background: #FFFFFF;
  border: 1rpx solid #E3EAEA;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(18, 55, 59, 0.04);
}

.exercise-item {
  display: flex;
  min-height: 168rpx;
  padding: 18rpx;
  border: 0;
  border-bottom: 1rpx solid #E8EEEE;
  border-radius: 0;
  box-shadow: none;
}

.exercise-item:last-child {
  border-bottom: 0;
}

.exercise-image {
  flex-shrink: 0;
  width: 184rpx;
  height: 132rpx;
  margin-right: 22rpx;
  background: #DDE8E7;
  border-radius: 16rpx;
}

.exercise-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.exercise-name {
  overflow: hidden;
  font-size: calc(32rpx * var(--app-font-scale, 1));
  font-weight: 700;
  line-height: 1.35;
  color: #213134;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exercise-target {
  display: block;
  margin-top: 5rpx;
  overflow: hidden;
  font-size: calc(25rpx * var(--app-font-scale, 1));
  color: #657579;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exercise-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.difficulty-tag {
  padding: 4rpx 12rpx;
  font-size: calc(23rpx * var(--app-font-scale, 1));
  font-weight: 650;
  line-height: 34rpx;
  border-radius: 8rpx;
}

.difficulty-tag.easy {
  color: #0A786C;
  background: #DDF4EF;
}

.difficulty-tag.medium {
  color: #A75D00;
  background: #FFF0D6;
}

.exercise-duration {
  margin-left: 16rpx;
  font-size: calc(25rpx * var(--app-font-scale, 1));
  color: #6F7F83;
}

.family-popup-footer .join-family-btn + .join-family-btn { margin-top: 16rpx; }
