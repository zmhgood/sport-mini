/* pages/goal/create.wxss */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.section {
  background: #FFFFFF;
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
}

.section-title {
  font-size: calc(32rpx * var(--app-font-scale, 1));
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.selected-count {
  font-size: calc(26rpx * var(--app-font-scale, 1));
  color: #3B82F6;
}

.add-btn {
  font-size: calc(28rpx * var(--app-font-scale, 1));
  color: #3B82F6;
}

.plan-types { display: flex; gap: 16rpx; }
.plan-type { flex: 1; min-height: 48px; display: flex; align-items: center; justify-content: center; border: 2rpx solid #CBD5E1; border-radius: 16rpx; color: #475569; font-size: calc(29rpx * var(--app-font-scale, 1)); }
.plan-type.active { border-color: #176B73; background: #EAF6F4; color: #135D60; font-weight: 600; }
.plan-hint { display: block; margin-top: 16rpx; color: #64748B; font-size: calc(25rpx * var(--app-font-scale, 1)); line-height: 1.5; }
.load-error { margin: 20rpx 24rpx; color: #9A3412; font-size: calc(27rpx * var(--app-font-scale, 1)); }
.retry-button { min-height: 44px; margin-top: 12rpx; padding: 0 22rpx; color: #135D60; background: #EAF6F4; border-radius: 22rpx; font-size: calc(26rpx * var(--app-font-scale, 1)); }
.self-participation { display: flex; gap: 14rpx; align-items: center; min-height: 48px; margin-top: 12rpx; color: #1E293B; font-size: calc(28rpx * var(--app-font-scale, 1)); }
.self-check { width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #94A3B8; border-radius: 8rpx; color: #fff; }
.self-check.checked { border-color: #176B73; background: #176B73; }

.name-input {
  width: 100%;
  height: 88rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: calc(32rpx * var(--app-font-scale, 1));
  box-sizing: border-box;
}

/* 成员选择 */
.member-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.member-item {
  width: calc(25% - 18rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: #F8FAFC;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  position: relative;
}

.member-item.selected {
  background: #EFF6FF;
  border-color: #3B82F6;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.member-name {
  width: 100%;
  padding: 0 8rpx;
  font-size: calc(26rpx * var(--app-font-scale, 1));
  color: #1E293B;
  text-align: center;
  word-break: break-all;
}

.check-icon {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background: #3B82F6;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(24rpx * var(--app-font-scale, 1));
}

/* 动作列表 */
.exercise-list {

}

.exercise-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.exercise-info {
  flex: 1;
}

.exercise-name {
  font-size: calc(30rpx * var(--app-font-scale, 1));
  color: #1E293B;
  display: block;
  margin-bottom: 12rpx;
}

.exercise-config {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.config-label {
  font-size: calc(26rpx * var(--app-font-scale, 1));
  color: #64748B;
}

.config-input {
  width: 80rpx;
  height: 56rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 8rpx;
  text-align: center;
  font-size: calc(28rpx * var(--app-font-scale, 1));
}

.remove-btn {
  font-size: calc(40rpx * var(--app-font-scale, 1));
  color: #EF4444;
  padding: 0 16rpx;
}

.empty-list {
  text-align: center;
  padding: 40rpx;
  color: #94A3B8;
  font-size: calc(28rpx * var(--app-font-scale, 1));
}

/* 提交 */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.btn-submit {
  width: 100%;
  height: 96rpx;
  min-height: 44px;
  background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%);
  color: #FFFFFF;
  font-size: calc(32rpx * var(--app-font-scale, 1));
  border-radius: 48rpx;
  border: none;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.5); }

.modal-content {
  position: relative;
  width: 100%;
  height: 85vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  flex-shrink: 0;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F1F5F9;
}

.modal-title {
  font-size: calc(34rpx * var(--app-font-scale, 1));
  font-weight: 600;
  color: #1E293B;
}

.modal-close {
  flex-shrink: 0;
  width: 44px;
  min-width: 44px;
  max-width: 44px;
  height: 44px;
  line-height: 44px;
  padding: 0;
  margin: 0 0 0 16rpx;
  background: transparent;
  font-size: calc(48rpx * var(--app-font-scale, 1));
  color: #94A3B8;
}
.modal-close::after { border: none; }

.modal-body {
  flex: 1;
  height: 0;
  min-height: 0;
}
.modal-list { padding: 24rpx; }

.exercise-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.exercise-option.selected {
  background: #EFF6FF;
  border-color: #3B82F6;
}

.option-name {
  display: block;
  font-size: calc(30rpx * var(--app-font-scale, 1));
  color: #1E293B;
  word-break: break-all;
}

.option-target {
  display: block;
  font-size: calc(26rpx * var(--app-font-scale, 1));
  color: #64748B;
  margin-top: 8rpx;
  margin-right: 16rpx;
  word-break: break-all;
}

.option-check {
  width: 40rpx;
  height: 40rpx;
  background: #3B82F6;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(24rpx * var(--app-font-scale, 1));
}

.modal-footer {
  flex-shrink: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F1F5F9;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  align-items: center;
}

.selected-count {
  flex: 1;
  min-width: 0;
  font-size: calc(28rpx * var(--app-font-scale, 1));
  color: #64748B;
}

.btn-confirm {
  flex-shrink: 0;
  margin: 0;
  min-width: 200rpx;
  height: 72rpx;
  min-height: 44px;
  line-height: 72rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%);
  color: #FFFFFF;
  font-size: calc(28rpx * var(--app-font-scale, 1));
  border-radius: 36rpx;
  border: none;
  padding: 0 32rpx;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F1F5F9;
}

.category-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: calc(28rpx * var(--app-font-scale, 1));
  color: #64748B;
  background: #F1F5F9;
  border-radius: 40rpx;
  transition: all 0.3s ease;
}

.category-tab.active {
  background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%);
  color: #FFFFFF;
  font-weight: 500;
}

/* 动作选项 */
.option-left {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.option-right {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 12rpx;
}

.option-category {
  font-size: calc(22rpx * var(--app-font-scale, 1));
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #FFFFFF;
  background: #5E6E72;
}

.option-category.upper {
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
}

.option-category.core {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
}

.option-category.lower {
  background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
}
