.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: flex;
  box-sizing: border-box;
  height: calc(var(--app-tab-height, 112rpx) + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  border-top: 1rpx solid #E3EAEA;
  box-shadow: 0 -6rpx 24rpx rgba(18, 55, 59, 0.05);
}

.tab-bar-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: var(--app-tab-height, 112rpx);
  padding: 6rpx 0;
}

.tab-bar-item::before {
  position: absolute;
  top: 0;
  width: 44rpx;
  height: 5rpx;
  content: '';
  background: transparent;
  border-radius: 0 0 6rpx 6rpx;
}

.tab-bar-item.selected::before {
  background: #176B73;
}

.tab-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.tab-text {
  flex-shrink: 0;
  margin-top: 4rpx;
  font-size: calc(24rpx * var(--app-font-scale, 1));
  font-weight: 500;
  line-height: 1.25;
  white-space: nowrap;
  color: #7A858B;
}

.tab-bar-item.selected .tab-text {
  font-weight: 650;
  color: #176B73;
}
