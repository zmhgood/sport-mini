<page-meta page-style="{{fontPageStyle}}" />
<!--pages/gif-viewer/gif-viewer.wxml-->
<view class="container">
  <video
    wx:if="{{isVideo}}"
    class="gif-image"
    src="{{src}}"
    controls
    binderror="onImageError"
  ></video>
  <image
    wx:else
    class="gif-image"
    src="{{src}}"
    mode="aspectFit"
    show-menu-by-longpress
    binderror="onImageError"
  ></image>

  <!-- 提示信息 -->
  <view class="tips" wx:if="{{!isVideo}}">
    <text class="tip-text">💡 提示：长按图片可保存到相册</text>
  </view>
</view>
