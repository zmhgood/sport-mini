<!--pages/goal/detail.wxml-->
<page-meta page-style="{{fontPageStyle}} {{previewExercise ? 'overflow: hidden;' : ''}}" />
<view class="container">
  <view class="load-state" wx:if="{{loading}}">
    <text>正在加载，请稍候…</text>
  </view>
  <view class="load-state" wx:elif="{{loadError}}">
    <text>{{loadError}}</text>
    <button class="retry-btn" bindtap="loadDetails">重试</button>
  </view>
  <block wx:else>
  <!-- 目标信息 -->
  <view class="goal-header">
    <view class="goal-heading">
      <text class="goal-name">{{goal.name}}</text>
      <button class="more-toggle" size="mini" wx:if="{{goal.can_manage || (goal.plan_type === 'shared' && goal.is_participating)}}" bindtap="toggleMore" disabled="{{actionLoading}}" aria-label="更多计划操作">更多 ···</button>
    </view>
    <text class="plan-badge">{{goal.plan_type === 'personal' ? '个人计划' : '共同计划'}}{{goal.is_active == false ? ' · 已暂停' : ''}}</text>
    <view class="goal-stats">
      <text class="stat-item">{{goal.memberCount || 0}}人参与</text>
      <text class="stat-divider">|</text>
      <text class="stat-item">{{goal.exerciseCount || 0}}个动作</text>
    </view>
  </view>

  <view class="join-area" wx:if="{{goal.plan_type === 'shared' && !goal.is_participating && goal.is_active != false}}">
    <button class="primary-action join-action" bindtap="joinGoal" loading="{{starting}}" disabled="{{starting}}">加入并开始</button>
  </view>

  <!-- 今日进度 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">{{historicalView ? progressDate + ' 进度' : '今日进度'}}</text>
      <text class="section-action" bindtap="goProgress">查看详情</text>
    </view>
    <view class="progress-list">
      <view class="progress-item" wx:for="{{progress.member_stats}}" wx:key="user_id">
        <view class="member-row">
          <image class="member-avatar" src="{{item.user_avatar || '/images/default-avatar.svg'}}"></image>
          <view class="member-info">
            <text class="member-name">{{item.user_name}}{{item.is_current_member === false ? '（已离开）' : ''}}</text>
            <!-- 分段进度条 -->
            <view class="segmented-progress-wrap" wx:if="{{item.exercise_stats && item.exercise_stats.length > 0}}">
              <view class="segmented-progress">
                <view class="progress-segment" 
                      wx:for="{{item.exercise_stats}}" wx:for-item="ex" wx:key="goal_exercise_id"
                      style="width: {{ex.segment_width}}%;">
                  <view class="segment-bg" style="background-color: {{ex.color}};"></view>
                  <view class="segment-fill" style="width: {{ex.fill_width}}%; background-color: {{ex.color}};"></view>
                </view>
              </view>
              <text class="progress-text">{{item.completed_sets}}/{{item.total_sets}}组</text>
            </view>
              <!-- 动作图例 -->
              <view class="progress-legend" wx:if="{{item.exercise_stats && item.exercise_stats.length > 0}}">
                <view class="legend-item" wx:for="{{item.exercise_stats}}" wx:for-item="ex" wx:key="goal_exercise_id">
                  <view class="legend-color" style="background-color: {{ex.color}};"></view>
                  <text class="legend-name">{{ex.exercise_name}}</text>
                </view>
              </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 动作列表 -->
  <view class="section">
    <view class="section-title">锻炼动作</view>
    <view class="exercise-list">
      <view class="exercise-item" wx:for="{{goal.exercises}}" wx:key="id">
        <view class="exercise-main" bindtap="showExercisePreview" data-item="{{item}}" aria-role="button" aria-label="查看{{item.exercise.name || item.exercise_name || item.name}}动作示范">
          <image class="exercise-image" src="{{item.exercise.image_url || '/images/exercise/default-exercise.jpg'}}" mode="aspectFit"></image>
          <view class="exercise-info">
            <text class="exercise-name">{{item.exercise.name || item.exercise_name || item.name}}</text>
            <text class="exercise-target">{{item.exercise.target_muscle}}</text>
            <text class="exercise-sets">{{item.sets}}组 × {{item.reps}}次</text>

          </view>
        </view>
        <button class="exercise-demo" bindtap="showExercisePreview" data-item="{{item}}">查看动作示范</button>
        <view class="exercise-actions" wx:if="{{canSubmit}}">
          <button class="primary-action" bindtap="completeAll" loading="{{actionLoading}}" disabled="{{actionLoading || exerciseStatus[item.id].is_done}}" data-item="{{item}}">{{exerciseStatus[item.id].is_done ? '已完成' : '完成全部'}}</button>
          <button class="partial-toggle" bindtap="togglePartial" disabled="{{actionLoading}}" data-item="{{item}}">{{partialSets[item.id] ? '收起分组' : '部分完成'}}</button>
        </view>
        <text class="readonly-action" wx:elif="{{historicalView && canRecord}}">历史进度仅供查看</text>
        <text class="readonly-action" wx:elif="{{goal.is_active == false && canRecord}}">计划已暂停</text>
        <view class="partial-panel" wx:if="{{partialSets[item.id] && canSubmit}}">
          <view class="partial-set {{partialChecked ? 'checked' : ''}}" wx:for="{{partialSets[item.id]}}" wx:for-item="partialChecked" wx:key="index" bindtap="togglePartialSet" data-id="{{item.id}}" data-index="{{index}}">第 {{index + 1}} 组　{{partialChecked ? '✓' : '○'}}</view>
          <button class="partial-save" bindtap="savePartial" data-id="{{item.id}}" loading="{{actionLoading}}" disabled="{{actionLoading}}">保存已完成组</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 参与成员 -->
  <view class="section">
    <view class="section-title">参与成员</view>
    <view class="member-progress-list">
      <view class="member-progress-item" wx:for="{{memberProgressList}}" wx:key="user_id">
        <view class="member-header">
          <image class="member-avatar-small" src="{{item.user_avatar || '/images/default-avatar.svg'}}"></image>
          <text class="member-name-small">{{item.user_name}}{{item.is_current_member === false ? '（已离开）' : ''}}</text>
          <text class="member-progress-text">{{item.completed_sets}}/{{item.total_sets}}组</text>
        </view>
        <view class="mini-progress-bar">
          <view class="mini-progress-fill" style="width: {{item.progress_percent}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  </block>
</view>
<view class="preview-modal" wx:if="{{previewExercise}}">
  <view class="preview-backdrop" bindtap="closeExercisePreview" catchtouchmove="stopPropagation"></view>
  <view class="preview-panel" catchtap="stopPropagation" catchtouchmove="stopPropagation">
    <view class="preview-header">
      <text class="preview-title">{{previewExercise.name}}</text>
      <button class="preview-close" size="mini" bindtap="closeExercisePreview" aria-label="关闭动作示范">×</button>
    </view>
    <exercise-media exercise="{{previewExercise}}" exercise-id="{{previewExerciseId}}" />
  </view>
</view>
