.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: flex;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #E3EAEA;
  box-shadow: 0 -6rpx 24rpx rgba(18, 55, 59, 0.05);
}

.tab-bar-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 8rpx 0;
}

.tab-bar-item::before {
  position: absolute;
  top: 0;
  width: 44rpx;
  height: 5rpx;
  content: '';
  background: transparent;
  border-radius: 0 0 6rpx 6rpx;
}

.tab-bar-item.selected::before {
  background: #176B73;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  margin-top: 5rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 30rpx;
  color: #7A858B;
}

.tab-bar-item.selected .tab-text {
  font-weight: 650;
  color: #176B73;
}
