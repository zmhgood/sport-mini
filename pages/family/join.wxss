/* pages/family/join.wxss */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 40rpx;
}

.form-section {
  background: #FFFFFF;
  padding: 40rpx;
  border-radius: 24rpx;
}

.form-title {
  font-size: calc(36rpx * var(--app-font-scale, 1));
  font-weight: 600;
  color: #1E293B;
  text-align: center;
  margin-bottom: 48rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: calc(28rpx * var(--app-font-scale, 1));
  color: #64748B;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: calc(32rpx * var(--app-font-scale, 1));
  box-sizing: border-box;
}

.btn-submit {
  width: 100%;
  height: 96rpx;
  min-height: 44px;
  background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%);
  color: #FFFFFF;
  font-size: calc(32rpx * var(--app-font-scale, 1));
  border-radius: 48rpx;
  border: none;
  margin-top: 48rpx;
}
.privacy-notice {
  margin: 24rpx 0;
  padding: 0 24rpx;
  font-size: calc(24rpx * var(--app-font-scale, 1));
  line-height: 1.7;
  color: #596970;
}

.privacy-link {
  padding: 16rpx 0;
  color: #176B73;
}
