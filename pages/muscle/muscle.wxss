.container {
  min-height: 100vh;
  padding-bottom: calc(var(--app-tab-height, 112rpx) + 36rpx + env(safe-area-inset-bottom));
  background: #F4F7F7;
}

.tabs {
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 14rpx 24rpx 18rpx;
  background: linear-gradient(180deg, #176B73 0, #176B73 65%, #F4F7F7 65%);
}

.tabs::before {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 80rpx;
  content: '';
  background: #42B8A5;
  border-radius: 50% 50% 0 0;
  opacity: 0.85;
}

.tab-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  font-size: calc(30rpx * var(--app-font-scale, 1));
  font-weight: 600;
  color: #4F6064;
  background: #FFFFFF;
  border-right: 1rpx solid #E5EBEB;
}

.tab-item:first-child {
  border-radius: 18rpx 0 0 18rpx;
}

.tab-item:last-child {
  border-right: 0;
  border-radius: 0 18rpx 18rpx 0;
}

.tab-item.active {
  color: #FFFFFF;
  background: #176B73;
}

.muscle-intro {
  margin: 12rpx 24rpx 0;
  padding: 26rpx;
}

.intro-header {
  align-items: center;
}

.intro-icon {
  flex-shrink: 0;
  width: 170rpx;
  height: 190rpx;
  margin-right: 26rpx;
  background: #EDF6F5;
  border-radius: 18rpx;
}

.intro-text {
  flex: 1;
  min-width: 0;
}

.intro-name {
  display: block;
  font-size: calc(40rpx * var(--app-font-scale, 1));
  font-weight: 700;
  line-height: 1.3;
  color: #172629;
}

.intro-desc {
  display: block;
  margin-top: 8rpx;
  font-size: calc(26rpx * var(--app-font-scale, 1));
  line-height: 1.55;
  color: #5F7074;
}

.muscle-tags {
  gap: 10rpx;
  margin-top: 14rpx;
}

.muscle-tag {
  padding: 4rpx 12rpx;
  font-size: calc(23rpx * var(--app-font-scale, 1));
  font-weight: 600;
  line-height: 34rpx;
  color: #0A786C;
  background: #DDF4EF;
  border-radius: 8rpx;
}

.exercise-section {
  padding: 34rpx 24rpx 0;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 58rpx;
  margin-bottom: 16rpx;
}

.loading {
  padding: 96rpx 0;
  font-size: calc(28rpx * var(--app-font-scale, 1));
  color: #718084;
  text-align: center;
}

.exercise-list {
  overflow: hidden;
  background: #FFFFFF;
  border: 1rpx solid #E3EAEA;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(18, 55, 59, 0.04);
}

.exercise-card {
  padding: 22rpx;
  border: 0;
  border-bottom: 1rpx solid #E8EEEE;
  border-radius: 0;
  box-shadow: none;
}

.exercise-card:last-child {
  border-bottom: 0;
}

.card-header {
  margin-bottom: 16rpx;
}

.exercise-name {
  font-size: calc(34rpx * var(--app-font-scale, 1));
  font-weight: 700;
  color: #213134;
}

.difficulty-tag {
  padding: 4rpx 12rpx;
  font-size: calc(23rpx * var(--app-font-scale, 1));
  font-weight: 650;
  line-height: 34rpx;
  border-radius: 8rpx;
}

.difficulty-tag.easy {
  color: #0A786C;
  background: #DDF4EF;
}

.difficulty-tag.medium {
  color: #A75D00;
  background: #FFF0D6;
}

.exercise-image {
  width: 100%;
  height: 300rpx;
  background: #DDE8E7;
  border-radius: 16rpx;
}

.card-info {
  padding-top: 18rpx;
}

.info-row {
  min-height: 46rpx;
}

.info-label {
  flex-shrink: 0;
  width: 166rpx;
  font-size: calc(26rpx * var(--app-font-scale, 1));
  color: #718084;
}

.info-value {
  font-size: calc(27rpx * var(--app-font-scale, 1));
  font-weight: 600;
  color: #35464A;
}
