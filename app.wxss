page {
  box-sizing: border-box;
  min-height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: calc(32rpx * var(--app-font-scale, 1));
  line-height: 1.55;
  color: #243235;
  background: #F4F7F7;
}

view,
text,
image,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: inherit;
  text-align: center;
}

button::after {
  border: 0;
}

.primary-color,
.text-primary {
  color: #176B73;
}

.primary-bg,
.gradient-primary {
  background: linear-gradient(135deg, #176B73, #24958F);
}

.btn-large {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 100rpx;
  padding: 0 32rpx;
  font-size: calc(34rpx * var(--app-font-scale, 1));
  font-weight: 650;
  line-height: 1.2;
  color: #FFFFFF;
  background: #176B73;
  border: 0;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(23, 107, 115, 0.18);
}

.btn-large:active {
  background: #105B62;
  transform: scale(0.985);
}

.card {
  background: #FFFFFF;
  border: 1rpx solid #E3EAEA;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(18, 55, 59, 0.05);
}

.title-large {
  font-size: calc(44rpx * var(--app-font-scale, 1));
  font-weight: 700;
  line-height: 1.3;
  color: #172629;
}

.title-medium {
  font-size: calc(36rpx * var(--app-font-scale, 1));
  font-weight: 700;
  line-height: 1.35;
  color: #172629;
}

.text-secondary {
  color: #5F6F73;
}

.text-hint {
  font-size: calc(27rpx * var(--app-font-scale, 1));
  color: #7A898D;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }
.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }

.divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: #E3EAEA;
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.gradient-warm {
  background: linear-gradient(135deg, #E69A32, #F0B252);
}

.gradient-green {
  background: linear-gradient(135deg, #176B73, #42B8A5);
}
