/* pages/exercise/exercise.wxss */

.container {
  background: linear-gradient(180deg, #EEF2FF 0%, #F8FAFC 20%);
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 媒体区域 */
.media-section {
  position: relative;
  width: 100%;
  height: 480rpx;
  background: linear-gradient(135deg, #C7D2FE 0%, #A5B4FC 100%);
}

.cover-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 180rpx;
  height: 180rpx;
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(99, 102, 241, 0.4);
}

.play-icon {
  font-size: calc(56rpx * var(--app-font-scale, 1));
  color: #FFFFFF;
  margin-left: 8rpx;
}

.play-text {
  font-size: calc(24rpx * var(--app-font-scale, 1));
  color: #FFFFFF;
  margin-top: 8rpx;
}

.no-gif-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.5);
  padding: 20rpx 40rpx;
  border-radius: 32rpx;
}

.no-gif-tip text {
  color: #FFFFFF;
  font-size: calc(28rpx * var(--app-font-scale, 1));
}

/* 信息区域 */
.info-section {
  margin: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

.exercise-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.exercise-name {
  font-size: calc(44rpx * var(--app-font-scale, 1));
  font-weight: 700;
  color: #1E293B;
  margin-right: 16rpx;
}

.difficulty-tag {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: calc(26rpx * var(--app-font-scale, 1));
  font-weight: 500;
}

.difficulty-tag.easy {
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
  color: #059669;
}

.difficulty-tag.medium {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  color: #D97706;
}

.info-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 28rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #F1F5F9;
  border-bottom: 1rpx solid #F1F5F9;
}

.info-item {
  text-align: center;
  flex: 1;
}

.info-value {
  display: block;
  font-size: calc(40rpx * var(--app-font-scale, 1));
  font-weight: 700;
  background: linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
}

.info-label {
  display: block;
  font-size: calc(26rpx * var(--app-font-scale, 1));
  color: #64748B;
}

.description {
  font-size: calc(30rpx * var(--app-font-scale, 1));
  color: #475569;
  line-height: 1.8;
  padding: 24rpx;
  background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%);
  border-radius: 16rpx;
  border-left: 6rpx solid #6366F1;
}
