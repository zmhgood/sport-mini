.media-frame {
  position: relative;
  height: 400rpx;
  max-height: 40vh;
  background: #F8FAFC;
  border-radius: 16rpx;
  overflow: hidden;
}
.media-content { width: 100%; height: 100%; display: block; }
.media-loading {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #64748B;
  font-size: 26rpx;
  pointer-events: none;
}
.media-status { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; margin-top: 16rpx; color: #64748B; font-size: 26rpx; }
.media-retry { margin: 0; min-height: 44px; padding: 0 24rpx; font-size: 28rpx; color: #176B73; }
