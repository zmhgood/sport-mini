<!--pages/goal/create.wxml-->
<view class="container">
  <view class="load-error" wx:if="{{isEditing && goalLoading}}">正在读取计划…</view>
  <view class="load-error" wx:if="{{goalError}}">
    <text>{{goalError}}</text>
    <button class="retry-button" bindtap="retryLoadGoal">重试读取计划</button>
  </view>
  <view class="load-error" wx:if="{{membersError}}">
    <text>{{membersError}}</text>
    <button class="retry-button" bindtap="loadMembers">重试加载成员</button>
  </view>
  <view class="load-error" wx:elif="{{membersLoading}}">正在加载家庭成员…</view>
  <!-- 目标名称 -->
  <view class="section">
    <view class="section-title">计划名称</view>
    <input class="name-input" placeholder="例如：每日健身计划" value="{{name}}" bindinput="onNameInput" cursor-spacing="96" />
  </view>

  <view class="section" wx:if="{{!isEditing}}">
    <view class="section-title">计划类型</view>
    <view class="plan-types">
      <view class="plan-type {{planType === 'personal' ? 'active' : ''}}" data-type="personal" bindtap="setPlanType">个人计划</view>
      <view class="plan-type {{planType === 'shared' ? 'active' : ''}}" data-type="shared" bindtap="setPlanType">共同计划</view>
    </view>
    <text class="plan-hint" wx:if="{{planType === 'personal'}}">每天自动安排；家庭管理员可为家人创建</text>
    <text class="plan-hint" wx:else>家庭成员可自愿加入；创建时只选择自己是否参加</text>
    <view class="self-participation" wx:if="{{planType === 'shared'}}" bindtap="toggleSharedParticipation">
      <text class="self-check {{participateInShared ? 'checked' : ''}}">{{participateInShared ? '✓' : ''}}</text>
      <text>我参加这个计划</text>
    </view>
  </view>

  <!-- 个人计划执行成员 -->
  <view class="section" wx:if="{{planType === 'personal'}}">
    <view class="section-header">
      <text class="section-title">计划成员</text>
    </view>
    <view class="member-grid" wx:if="{{members.length > 0}}">
      <view class="member-item {{item.selected ? 'selected' : ''}} {{isEditing ? 'read-only' : ''}}"
            wx:for="{{members}}" wx:key="user_id" 
            bindtap="onExecutorChange" data-id="{{item.user_id}}" wx:if="{{isEditing ? item.user_id == executorId : (isAdmin || item.user_id == currentUserId)}}">
        <image class="member-avatar" src="{{item.user.avatar_url || '/images/default-avatar.svg'}}"></image>
        <text class="member-name">{{item.user.nick_name || '家庭成员'}}{{item.user_id == currentUserId ? '（我）' : ''}}</text>
        <view class="check-icon" wx:if="{{item.selected}}">✓</view>
      </view>
    </view>
    <text class="plan-hint" wx:if="{{isEditing}}">执行成员仅展示，不可修改</text>
    <text class="plan-hint" wx:elif="{{!isAdmin}}">个人计划只由本人执行</text>
  </view>

  <!-- 选择动作 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">锻炼动作</text>
      <text class="add-btn" bindtap="addExercise">+ 添加动作</text>
    </view>
    <view class="exercise-list">
      <view class="exercise-item" wx:for="{{selectedExercises}}" wx:key="exercise_id">
        <view class="exercise-info">
          <text class="exercise-name">{{item.name}}</text>
          <view class="exercise-config">
            <text class="config-label">组数:</text>
            <input class="config-input" type="number" value="{{item.sets}}" bindinput="onSetsInput" data-index="{{index}}" data-field="sets" cursor-spacing="96" />
            <text class="config-label">每组次数:</text>
            <input class="config-input" type="number" value="{{item.reps}}" bindinput="onRepsInput" data-index="{{index}}" data-field="reps" cursor-spacing="96" />
          </view>
        </view>
        <text class="remove-btn" bindtap="removeExercise" data-index="{{index}}">×</text>
      </view>
    </view>
    <view class="empty-list" wx:if="{{selectedExercises.length === 0}}">
      <text>请添加锻炼动作</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
      <button class="btn-submit" bindtap="createGoal" loading="{{loading}}" disabled="{{loading || membersLoading || !membersLoaded || membersError || goalLoading || goalError || (isEditing && !goalLoaded)}}">{{isEditing ? '保存修改' : '创建计划'}}</button>
  </view>
</view>

<!-- 动作选择弹窗 -->
<view class="modal" wx:if="{{showExerciseModal}}" bindtap="closeExerciseModal">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">选择动作 (可多选)</text>
      <text class="modal-close" bindtap="closeExerciseModal">×</text>
    </view>
    <!-- 分类标签 -->
    <view class="category-tabs">
      <view class="category-tab {{currentCategory === 'all' ? 'active' : ''}}" 
            bindtap="switchCategory" data-category="all">全部</view>
      <view class="category-tab {{currentCategory === 'upper' ? 'active' : ''}}" 
            bindtap="switchCategory" data-category="upper">上肢</view>
      <view class="category-tab {{currentCategory === 'core' ? 'active' : ''}}" 
            bindtap="switchCategory" data-category="core">核心</view>
      <view class="category-tab {{currentCategory === 'lower' ? 'active' : ''}}" 
            bindtap="switchCategory" data-category="lower">下肢</view>
    </view>
    <scroll-view class="modal-body" scroll-y>
      <view class="exercise-option {{item._selected ? 'selected' : ''}}" 
            wx:for="{{filteredExerciseList}}" wx:key="id" 
            bindtap="selectExercise" data-item="{{item}}">
        <view class="option-left">
          <text class="option-name">{{item.name}}</text>
          <text class="option-target">{{item.target_muscle}}</text>
        </view>
        <view class="option-right">
          <text class="option-category {{item._category}}">{{item._categoryName}}</text>
          <view class="option-check" wx:if="{{item._selected}}">✓</view>
        </view>
      </view>
      <view class="empty-list" wx:if="{{filteredExerciseList.length === 0}}">
        <text>该分类暂无动作</text>
      </view>
    </scroll-view>
    <view class="modal-footer">
      <text class="selected-count">已选择 {{selectedCount}} 个动作</text>
      <button class="btn-confirm" bindtap="confirmExercises">确认选择</button>
    </view>
  </view>
</view>
