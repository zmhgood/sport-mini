.container {
  min-height: 100vh;
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
  background: #F4F7F7;
}

.user-section {
  position: relative;
  padding: 34rpx 24rpx 0;
  overflow: hidden;
  background: #F4F7F7;
}

.user-section::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 230rpx;
  content: '';
  background: linear-gradient(135deg, #0F626C, #16828A);
}

.user-section::after {
  position: absolute;
  top: 178rpx;
  right: -8%;
  left: -8%;
  height: 78rpx;
  content: '';
  background: #42B8A5;
  border-radius: 0 0 50% 50%;
  opacity: 0.85;
}

.header-family {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  min-height: 58rpx;
  padding: 0 18rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 30rpx;
}

.header-family-text {
  max-width: 200rpx;
  overflow: hidden;
  font-size: 25rpx;
  font-weight: 600;
  color: #FFFFFF;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  min-height: 152rpx;
  padding-bottom: 24rpx;
}

.login-card {
  opacity: 1;
}

.avatar {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  margin-right: 22rpx;
  background: #FFFFFF;
  border: 4rpx solid rgba(255, 255, 255, 0.88);
  border-radius: 50%;
}

.username {
  position: absolute;
  top: 14rpx;
  left: 134rpx;
  max-width: 320rpx;
  overflow: hidden;
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-desc {
  position: absolute;
  top: 72rpx;
  left: 134rpx;
  max-width: 390rpx;
  overflow: hidden;
  font-size: 27rpx;
  color: rgba(255, 255, 255, 0.88);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 30rpx 18rpx;
  margin-bottom: 18rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 52rpx;
  font-weight: 750;
  line-height: 1.2;
  color: #176B73;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #5E6E72;
}

.stat-divider {
  width: 1rpx;
  height: 76rpx;
  background: #DFE7E7;
}

.family-stats-card {
  position: relative;
  z-index: 2;
  padding: 0 24rpx;
  margin-bottom: 28rpx;
}

.family-stats-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
}

.family-stats-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #243437;
}

.family-stats-toggle {
  font-size: 22rpx;
  color: #66777B;
}

.family-stats-list {
  padding: 20rpx 0 24rpx;
  border-top: 1rpx solid #E6ECEC;
}

.family-stat-item {
  margin-bottom: 22rpx;
}

.family-stat-item:last-child {
  margin-bottom: 0;
}

.family-stat-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.family-stat-name {
  font-size: 28rpx;
  font-weight: 650;
  color: #2C3C3F;
}

.family-stat-detail {
  font-size: 25rpx;
  color: #6D7D81;
}

.family-stat-bar {
  height: 10rpx;
  overflow: hidden;
  background: #E6ECEC;
  border-radius: 6rpx;
}

.family-stat-progress {
  height: 100%;
  background: #42B8A5;
  border-radius: 6rpx;
  transition: width 0.25s ease;
}

.history-section,
.settings-section {
  padding: 32rpx 24rpx 0;
}

.section-header {
  min-height: 56rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #172629;
}

.more-btn {
  display: flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 8rpx;
  font-size: 28rpx;
  font-weight: 650;
  color: #176B73;
}

.chart-card {
  padding: 20rpx 18rpx 24rpx;
}

.chart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #E6ECEC;
}

.week-range {
  font-size: 28rpx;
  font-weight: 700;
  color: #2B3B3E;
}

.nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  background: #EDF3F3;
  border-radius: 50%;
}

.nav-btn.disabled {
  opacity: 0.35;
}

.nav-arrow {
  margin-top: -4rpx;
  font-size: 42rpx;
  line-height: 1;
  color: #176B73;
}

.chart-container {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 286rpx;
  padding-top: 22rpx;
}

.chart-bar {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.bar-wrapper {
  display: flex;
  align-items: flex-end;
  height: 152rpx;
}

.bar {
  position: relative;
  width: 28rpx;
  height: 130rpx;
  overflow: hidden;
  background: #E5ECEC;
  border-radius: 8rpx 8rpx 3rpx 3rpx;
}

.bar-fill {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 0;
  background: #42B8A5;
  border-radius: 8rpx 8rpx 3rpx 3rpx;
}

.chart-bar.has-data .bar-fill {
  min-height: 8rpx;
}

.bar-value {
  height: 34rpx;
  margin-top: 4rpx;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 34rpx;
  color: #176B73;
}

.bar-label {
  overflow: hidden;
  font-size: 23rpx;
  color: #536468;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-date {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #8A979A;
}

.settings-section > .section-title {
  display: block;
  margin-bottom: 16rpx;
}

.settings-list {
  padding: 0 24rpx;
}

.setting-item {
  min-height: 96rpx;
  border-bottom: 1rpx solid #E6ECEC;
}

.setting-item:last-child {
  border-bottom: 0;
}

.setting-left,
.setting-right {
  min-width: 0;
}

.setting-icon {
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  margin-right: 22rpx;
}

.setting-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #263639;
}

.setting-value {
  max-width: 190rpx;
  overflow: hidden;
  font-size: 26rpx;
  color: #77868A;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  margin-left: 12rpx;
  font-size: 34rpx;
  color: #8A979A;
}

.logout-section {
  padding: 28rpx 0 0;
}

.logout-btn {
  width: 100%;
  min-height: 92rpx;
  font-size: 30rpx;
  font-weight: 650;
  color: #B0443E;
  background: #FFFFFF;
  border: 1rpx solid #F0D8D5;
  border-radius: 20rpx;
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 46rpx 24rpx 30rpx;
}

.footer-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #829094;
}
